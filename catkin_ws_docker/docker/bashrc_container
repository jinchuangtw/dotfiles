# ~/.bashrc for GVINS ROS Noetic Docker container

# If not running interactively, don't do anything
case $- in
    *i*) ;;
      *) return;;
esac

# ------------------------------------------------------------
# Basic colors
# ------------------------------------------------------------
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
fi

alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'

alias ll='ls -alF --color=auto'
alias la='ls -A --color=auto'
alias l='ls -CF --color=auto'

# ------------------------------------------------------------
# ROS / catkin shortcuts
# ------------------------------------------------------------
alias cw='cd /home/developer/catkin_ws'
alias cs='cd /home/developer/catkin_ws/src'
alias cm='cd /home/developer/catkin_ws && catkin_make'
alias cb='cd /home/developer/catkin_ws && catkin build'
alias srcws='source /home/developer/catkin_ws/devel/setup.bash'
alias rl='rostopic list'
alias rn='rosnode list'
alias rgp='rosrun rqt_graph rqt_graph'

# ------------------------------------------------------------
# Safe ROS environment source
# ------------------------------------------------------------
if [ -f /opt/ros/noetic/setup.bash ]; then
    source /opt/ros/noetic/setup.bash
fi

if [ -f /home/developer/catkin_ws/devel/setup.bash ]; then
    source /home/developer/catkin_ws/devel/setup.bash
fi

# ------------------------------------------------------------
# Pretty prompt
# ------------------------------------------------------------
parse_git_branch() {
    git branch 2>/dev/null | sed -n '/^\*/s/^\* //p'
}

prompt_git() {
    local branch
    branch="$(parse_git_branch)"
    if [ -n "$branch" ]; then
        printf " \[\033[1;33m\]git:%s\[\033[0m\]" "$branch"
    fi
}

# Colors for PS1
C_RESET='\[\033[0m\]'
C_GREEN='\[\033[1;32m\]'
C_BLUE='\[\033[1;34m\]'
C_CYAN='\[\033[1;36m\]'
C_RED='\[\033[1;31m\]'

# Main prompt
PS1="${C_GREEN}[gvins-noetic:\${ROS_ROLE:-dev}]${C_RESET} ${C_CYAN}\u@\h${C_RESET} ${C_BLUE}\w${C_RESET}\$(prompt_git)\n${C_RED}\\\$${C_RESET} "

# ------------------------------------------------------------
# Helpful startup message
# ------------------------------------------------------------
echo -e "\033[1;32m[gvins-noetic]\033[0m ROS_DISTRO=${ROS_DISTRO:-unknown}, workspace=/home/developer/catkin_ws"
